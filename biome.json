{
	"$schema": "https://biomejs.dev/schemas/2.5.15/biome.json",
	"files": {
		"includes": [
			"**",
			"!**/gui/design",
			"!**/gui/dist",
			"!**/gui/src/components/ui",
			"!**/node_modules",
			"!**/target"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
